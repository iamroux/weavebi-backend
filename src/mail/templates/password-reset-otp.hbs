<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
</head>
<body>
  <div style="font-family: Arial, sans-serif; line-height: 1.6; background: #f9f9f9; padding: 20px;">
    <table style="max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
      <tr>
        <td style="padding: 40px; text-align: center;">
          <h2 style="color: #333333;">🔐 WeaveBI Password Reset Request</h2>
          <p style="color: #555555; font-size: 16px;">Hello, <strong>{{name}}</strong>!</p>
          <p style="color: #555555; font-size: 16px;">We received a request to reset the password for your account associated with <strong>{{email}}</strong>. Use the OTP below to proceed:</p>
          <div style="font-size: 32px; font-weight: bold; color: #4A90E2; margin: 20px 0;">{{otp}}</div>
          <p style="color: #777777; font-size: 14px;">This OTP will expire in 5 minutes. If you did not request a password reset, please ignore this email.</p>
          <p style="color: #777777; font-size: 14px;">Need help? <a href="mailto:support@weavebi.com" style="color: #4A90E2; text-decoration: none;">Contact Support</a></p>
        </td>
      </tr>
    </table>
    <p style="text-align: center; color: #999999; font-size: 12px; margin-top: 20px;">&copy; {{year}} WeaveBI. All rights reserved.</p>
  </div>
</body>
</html>
